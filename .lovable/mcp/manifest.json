{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "refosofficial",
      "version": "0.1.0",
      "title": "refosofficial"
    },
    "tools": [
      {
        "name": "list_apps",
        "title": "List Ref OS apps",
        "description": "List the built-in applications available in the Ref OS desktop environment.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Optional case-insensitive filter matched against app title or description."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_games",
        "title": "List RefGames titles",
        "description": "List the games bundled in the RefGames game center, optionally filtered by input type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "enum": [
                "keyboard",
                "touch"
              ],
              "description": "Filter by primary input type."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_terminal_commands",
        "title": "List terminal commands",
        "description": "List the commands supported by the Ref OS Terminal app, including easter eggs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_system_info",
        "title": "Get Ref OS system info",
        "description": "Return public information about Ref OS: version, vendor, boot flow, and supported input methods.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
